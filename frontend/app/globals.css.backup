:root {
  color-scheme: light;

  --navy: #102b52;
  --navy-deep: #091c37;
  --linen: #f1e4ca;
  --parchment: #e5d3b2;
  --parchment-rgb: 229,211,178;
  --ivory: #fbf4e7;
  --ink: #2b2926;
  --muted: #686158;
  --gold: #c29042;
  --gold-rgb: 194,144,66;
  --copper: #a76d3d;
  --copper-rgb: 167,109,61;
  --violet: #7665a7;
  --violet-rgb: 118,101,167;
  --violet-strong: #57477f;
  --green: #627a66;
  --danger: #9a4f47;
  --danger-rgb: 154,79,71;
  --border: rgba(151,112,58,.22);
  --border-rgb: 151,112,58;
  --shadow-rgb: 49,38,24;
  --shadow: 0 4px 14px rgba(var(--shadow-rgb),.08);

  /* Roles split out of the tokens above so each color can carry exactly one
     meaning in dark mode (see frontend/app/globals.css review notes). */
  --heading: #102b52;
  --surface: #fbf4e7;
  --surface-rgb: 251,244,231;
  --overlay-rgb: 9,28,55;
  --emphasis-rgb: 16,43,82;
  --disabled-fg: #777777;
  --disabled-bg: rgba(186,183,175,.65);
  --disabled-rgb: 90,90,90;
  --neutral-fg: #666666;
  --neutral-bg: #d7d5cf;
  --neutral-rgb: 80,80,80;
  --removed-wash: rgba(100,100,100,.055);
}
:root[data-theme="dark"] {
  color-scheme: dark;

  --navy: #2c5490;
  --navy-deep: #3a68ac;
  --linen: #1a1712;
  --parchment: #14120d;
  --parchment-rgb: 20,18,13;
  --ivory: #fbf4e7;
  --ink: #ece7db;
  --muted: #a89d8b;
  --gold: #d9a45f;
  --gold-rgb: 217,164,95;
  --copper: #cf9161;
  --copper-rgb: 207,145,97;
  --violet: #a99bd6;
  --violet-rgb: 169,155,214;
  --violet-strong: #d6cdec;
  --green: #8fac93;
  --danger: #d99087;
  --danger-rgb: 217,144,135;
  --border: rgba(198,178,145,.20);
  --border-rgb: 198,178,145;
  --shadow-rgb: 0,0,0;
  --shadow: 0 4px 14px rgba(var(--shadow-rgb),.45);

  --heading: #c7d5ea;
  --surface: #241f18;
  --surface-rgb: 36,31,24;
  --overlay-rgb: 9,28,55;
  --emphasis-rgb: 217,164,95;
  --disabled-fg: #9a9a9a;
  --disabled-bg: rgba(120,120,120,.28);
  --disabled-rgb: 190,190,190;
  --neutral-fg: #b0b0b0;
  --neutral-bg: #3a3a38;
  --neutral-rgb: 150,150,150;
  --removed-wash: rgba(160,160,160,.08);
}
* { box-sizing: border-box; }
html, body { min-height: 100%; }
body { margin: 0; color: var(--ink); font-family: var(--font-interface), sans-serif; background: var(--linen); background-image: radial-gradient(circle at 80% 5%, rgba(var(--gold-rgb),.10), transparent 30%), repeating-linear-gradient(0deg, rgba(88,65,34,.018) 0 1px, transparent 1px 4px); }
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
h1,h2,h3 { margin: 0; color: var(--heading); font-family: var(--font-display), serif; line-height: 1.05; }
h1 { font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 600; }
h2 { font-size: 1.65rem; }
p { line-height: 1.6; }
.card { background: rgba(var(--surface-rgb),.88); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); }
.eyebrow { color: var(--copper); font-size: .75rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
.button { border-radius: 9px; border: 1px solid transparent; padding: .72rem 1rem; font-weight: 600; transition: 150ms ease; }
.button:hover { transform: translateY(-1px); }
.button.primary { color: var(--ivory); background: var(--navy); box-shadow: 0 5px 14px rgba(var(--overlay-rgb),.18); }
.button.primary:hover { background: var(--navy-deep); }
.button.secondary { color: var(--heading); background: transparent; border-color: rgba(var(--emphasis-rgb),.35); }
.button.ghost { color: var(--muted); background: transparent; border-color: var(--border); }
.button:disabled { opacity: .55; cursor: not-allowed; transform: none; }
.text-button { padding: 0; color: var(--heading); background: none; border: none; text-decoration: underline; }
label { display: grid; gap: .38rem; color: var(--heading); font-weight: 600; }
input, textarea, select { width: 100%; padding: .78rem .85rem; color: var(--ink); background: rgba(var(--surface-rgb),.8); border: 1px solid rgba(var(--border-rgb),.36); border-radius: 8px; outline: none; }
input:focus, textarea:focus, select:focus { border-color: rgb(var(--emphasis-rgb)); box-shadow: 0 0 0 3px rgba(var(--emphasis-rgb),.10); }
textarea { resize: vertical; line-height: 1.65; }
.error-message { color: var(--danger); }
.brand-mark { display: flex; align-items: center; gap: .9rem; color: var(--heading); }
.brand-mark strong { display: block; font-family: var(--font-display), serif; font-size: 1.45rem; }
.brand-mark small { color: var(--muted); }
.brand-orbit { display: grid; place-items: center; width: 64px; aspect-ratio: 1; border: 1px solid rgba(var(--gold-rgb),.55); border-radius: 50%; position: relative; }
.brand-orbit::before, .brand-orbit::after { content: ""; position: absolute; inset: 8px -5px; border: 1px solid rgba(var(--gold-rgb),.35); border-radius: 50%; transform: rotate(45deg); }
.brand-orbit span { color: var(--gold); font-size: 1.5rem; }
.auth-page { min-height: 100vh; display: grid; grid-template-columns: 1.2fr minmax(360px, .8fr); gap: 6vw; align-items: center; padding: 7vw; }
.auth-page.single { display: grid; grid-template-columns: minmax(320px, 700px); justify-content: center; }
.auth-story { max-width: 800px; }
.auth-story h1 { margin: 4rem 0 1rem; }
.auth-story > p { max-width: 650px; font-size: 1.15rem; color: var(--muted); }
.celestial-divider { width: 220px; margin-top: 3rem; color: var(--gold); text-align: center; border-bottom: 1px solid rgba(var(--gold-rgb),.5); line-height: 0; }
.auth-panel { padding: 2.2rem; }
.auth-panel.wide { max-width: 700px; }
.auth-panel h2, .auth-panel h1 { margin-bottom: 1.4rem; font-size: 2.2rem; }
.auth-panel form { display: grid; gap: 1rem; margin: 1.2rem 0; }
.auth-panel small { display: block; color: var(--muted); margin-top: 1rem; }
.app-shell { min-height: 100vh; display: grid; grid-template-columns: 270px 1fr; }
.sidebar { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 2.2rem 1.5rem; background: rgba(var(--parchment-rgb),.58); border-right: 1px solid var(--border); }
.sidebar nav { display: grid; gap: .4rem; margin: 3rem 0; }
.sidebar nav a, .disabled-nav { display: flex; gap: .65rem; align-items: center; padding: .75rem .9rem; border-radius: 9px; }
.sidebar nav a.active { color: var(--ivory); background: var(--navy); }
.disabled-nav { color: var(--muted); }
.disabled-nav em { margin-left: auto; font-size: .68rem; }
.sidebar blockquote { margin: auto 0 2rem; color: var(--muted); font-family: var(--font-display), serif; font-style: italic; text-align: center; }
.main-content { width: 100%; max-width: 1500px; margin: 0 auto; padding: 3.2rem clamp(1.2rem, 4vw, 4.5rem); }
.page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-bottom: 2rem; }
.page-header h1 { margin: .15rem 0 .6rem; }
.page-header p { margin: .3rem 0; color: var(--muted); }
.header-actions { display: flex; gap: .7rem; flex-wrap: wrap; justify-content: flex-end; }
.party-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.2rem; }
.party-card { min-height: 250px; padding: 1.6rem; }
.party-card p { color: var(--muted); }
.party-card small { color: var(--copper); font-weight: 600; }
.party-sigil { display: grid; place-items: center; width: 50px; height: 50px; margin-bottom: 2rem; color: var(--gold); border: 1px solid var(--border); border-radius: 50%; }
.create-card { display: grid; gap: .8rem; }
.notice, .email-invite, .create-chronicle { margin: 1rem 0 1.5rem; padding: 1.2rem; }
.notice input { margin: .7rem 0; }
.notice > div, .inline-form { display: flex; gap: .7rem; }
.email-invite summary { color: var(--heading); font-weight: 600; cursor: pointer; }
.email-invite .inline-form { margin-top: 1rem; }
.create-chronicle { display: grid; gap: 1rem; }
.segmented { display: flex; width: fit-content; padding: 4px; background: rgba(var(--parchment-rgb),.65); border-radius: 9px; }
.segmented button { padding: .55rem .8rem; color: var(--muted); background: none; border: none; border-radius: 7px; }
.segmented button.active { color: var(--ivory); background: var(--navy); }
.checkbox { display: flex; align-items: center; gap: .5rem; font-weight: 400; }
.checkbox input { width: auto; }
.chronicle-grid { display: grid; gap: .8rem; }
.chronicle-card { height: 185px; min-height: 185px; display: grid; grid-template-columns: 170px 1fr; overflow: hidden; transition: 160ms ease; }
.chronicle-card:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(var(--shadow-rgb),.12); }
.chronicle-card.featured { border-color: rgba(var(--gold-rgb),.65); }
.chronicle-art { display: grid; place-items: center; min-height: 185px; color: var(--gold); font-size: 2rem; background-color: var(--navy); background-image: radial-gradient(circle, transparent 0 25%, rgba(var(--gold-rgb),.28) 26% 27%, transparent 28%), repeating-radial-gradient(circle, transparent 0 14px, rgba(var(--gold-rgb),.16) 15px 16px); }
.art-1 { color: var(--navy); background-color: #eee2ca; }
.art-2 { color: var(--green); background-color: #dbe2dc; }
.art-3 { color: var(--ivory); background-color: #75679b; }
.chronicle-copy { padding: 1.3rem 1.5rem; overflow: hidden; }
.card-heading { display: flex; justify-content: space-between; gap: 1rem; }
.chronicle-copy p { display: -webkit-box; overflow: hidden; color: var(--muted); -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.status-pill { height: fit-content; padding: .32rem .55rem; border-radius: 999px; color: var(--muted); background: rgba(var(--parchment-rgb),.7); font-size: .68rem; letter-spacing: .07em; white-space: nowrap; }
.status-published { color: var(--violet-strong); background: rgba(var(--violet-rgb),.13); }
.status-in_progress, .status-ai_pending, .status-ai_processing { color: var(--copper); }
.empty-state { padding: 4rem; text-align: center; }
.empty-state span { color: var(--gold); font-size: 2rem; }
.generated-story { padding: 2rem clamp(1.3rem, 4vw, 4rem); margin-bottom: 2.3rem; }
.generated-story h2 { font-size: 2.5rem; margin-bottom: 1.5rem; }
.story-prose { max-width: 860px; white-space: pre-wrap; font-family: var(--font-display), serif; font-size: 1.25rem; line-height: 1.85; }
.section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border); }
.section-heading span { color: var(--muted); }
.thread-item { display: grid; grid-template-columns: 42px 1fr; gap: .7rem; position: relative; margin-bottom: .8rem; }
.thread-item::before { content: ""; position: absolute; left: 20px; top: 42px; bottom: -.9rem; border-left: 1px solid rgba(var(--gold-rgb),.4); }
.thread-marker { z-index: 1; display: grid; place-items: center; width: 42px; height: 42px; color: var(--heading); background: var(--linen); border: 1px solid rgba(var(--gold-rgb),.65); border-radius: 50%; }
.thread-body { padding: 1.2rem 1.4rem; }
.thread-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); }
.thread-meta strong { color: var(--heading); }
.segment-content { white-space: pre-wrap; font-family: var(--font-display), serif; font-size: 1.15rem; }
.thread-item.disabled .thread-body { color: var(--disabled-fg); background: var(--disabled-bg); border-color: rgba(var(--disabled-rgb),.24); filter: grayscale(.55); }
.removal-reason { padding: .6rem .8rem; background: rgba(var(--disabled-rgb),.08); border-left: 3px solid var(--disabled-fg); }
.thread-actions { display: flex; gap: .5rem; }
.thread-actions button { padding: .35rem .55rem; color: var(--heading); background: transparent; border: 1px solid var(--border); border-radius: 6px; }
.hidden-fragment { display: grid; align-content: center; gap: .4rem; padding: 1rem; color: var(--muted); background: repeating-linear-gradient(135deg, rgba(var(--emphasis-rgb),.05) 0 8px, rgba(var(--emphasis-rgb),.09) 8px 9px); border: 1px dashed rgba(var(--emphasis-rgb),.22); border-radius: 8px; }
.hidden-fragment span { color: var(--heading); font-weight: 600; }
.hidden-short { min-height: 80px; } .hidden-medium { min-height: 130px; } .hidden-long { min-height: 190px; } .hidden-extra_long { min-height: 250px; }
.pending-fragment { padding: 1rem; color: var(--muted); background: rgba(var(--parchment-rgb),.35); border-radius: 8px; }
.turn-editor, .written-editor { margin-top: 2rem; padding: 1.5rem; }
.editor-actions { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1rem; }
.lock-banner { margin-bottom: 1rem; padding: .7rem; background: rgba(var(--copper-rgb),.12); border-left: 3px solid var(--copper); }
@media (max-width: 900px) {
  .auth-page { grid-template-columns: 1fr; }
  .auth-story h1 { margin-top: 3rem; }
  .app-shell { grid-template-columns: 1fr; }
  .sidebar { position: static; height: auto; padding: 1rem; }
  .sidebar nav { display: flex; overflow-x: auto; margin: 1.2rem 0 0; }
  .sidebar blockquote, .sidebar > button { display: none; }
  .page-header { flex-direction: column; }
  .chronicle-card { height: auto; min-height: 165px; grid-template-columns: 100px 1fr; }
  .chronicle-art { min-height: 100%; }
}
@media (max-width: 600px) {
  .main-content { padding: 1.4rem 1rem; }
  .brand-mark small { display: none; }
  .page-header h1 { font-size: 2.7rem; }
  .chronicle-card { height: auto; grid-template-columns: 1fr; }
  .chronicle-art { min-height: 90px; }
  .card-heading, .thread-meta { flex-direction: column; }
  .notice > div, .inline-form { flex-direction: column; }
  .auth-page { padding: 1rem; }
}

.members-panel { margin: 1rem 0 1.5rem; padding: 1.2rem; }
.members-panel summary { color: var(--heading); font-weight: 600; cursor: pointer; }
.member-list { display: grid; gap: .6rem; margin-top: 1rem; }
.member-row { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: .7rem 0; border-bottom: 1px solid var(--border); }
.member-row small { display: block; color: var(--muted); }
.member-actions { display: flex; gap: .4rem; flex-wrap: wrap; }
.editors-panel { margin: 1rem 0 1.5rem; padding: 1.2rem; }
.editors-panel summary { color: var(--heading); font-weight: 600; cursor: pointer; }
.editors-panel > p { color: var(--muted); }
.editor-permissions { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .65rem; margin: 1rem 0; }
.editor-permissions .checkbox { padding: .7rem; background: rgba(var(--parchment-rgb),.28); border: 1px solid var(--border); border-radius: 8px; }
.editor-permissions small { color: var(--muted); }
.chronicle-card.building { box-shadow: var(--shadow), inset 0 0 42px rgba(var(--emphasis-rgb),.075); }
.chronicle-card.building .chronicle-copy { background: linear-gradient(135deg, rgba(var(--emphasis-rgb),.018), rgba(var(--violet-rgb),.035)); }

/* Product navigation and account refinements */
.mobile-rail,
.mobile-menu-backdrop,
.sidebar-mobile-heading { display: none; }
.desktop-brand { display: block; }
.sidebar-account { display: grid; gap: .5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
.sidebar-account strong { color: var(--heading); }
.sidebar-account span { color: var(--muted); font-size: .86rem; }
.back-link { display: inline-flex; align-items: center; gap: .35rem; margin-bottom: 1.2rem; color: var(--heading); font-weight: 600; }
.back-link:hover { text-decoration: underline; }
.button.danger-outline { color: var(--danger); background: transparent; border-color: rgba(var(--danger-rgb),.4); }
.success-message { color: var(--green); }
.modal-layer { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 1rem; background: rgba(var(--overlay-rgb),.42); backdrop-filter: blur(4px); }
.account-modal { width: min(520px, 100%); padding: 1.5rem; }
.modal-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
.modal-heading p { margin: .25rem 0; color: var(--muted); }
.modal-close, .sidebar-close { width: 38px; height: 38px; color: var(--heading); background: transparent; border: 1px solid var(--border); border-radius: 50%; font-size: 1.5rem; line-height: 1; }
.password-form { display: grid; gap: .9rem; margin-top: 1.3rem; }
.theme-toggle { display: grid; gap: .5rem; margin: 1.1rem 0 1.3rem; }
.membership-explanation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin: 1rem 0; }
.membership-explanation p { margin: 0; padding: .8rem; color: var(--muted); background: rgba(var(--parchment-rgb),.28); border-radius: 8px; }
.member-removed { opacity: .72; background: var(--removed-wash); }
.removed-note { align-self: center; color: var(--muted); font-size: .8rem; font-weight: 600; }
.action-message { position: sticky; bottom: 1rem; z-index: 10; width: fit-content; padding: .7rem 1rem; background: var(--surface); border: 1px solid rgba(var(--danger-rgb),.3); border-radius: 8px; box-shadow: var(--shadow); }

/* Chronicle flow */
.turn-composer { margin: 0 0 2rem; border-color: rgba(var(--emphasis-rgb),.35); box-shadow: 0 12px 32px rgba(var(--emphasis-rgb),.10); }
.turn-composer h2 { margin-bottom: 1rem; }
.last-message { margin-top: 1rem; padding: 1rem 1.1rem; background: rgba(var(--parchment-rgb),.34); border-left: 3px solid var(--gold); border-radius: 7px; }
.last-message > span { display: block; margin-bottom: .35rem; color: var(--copper); font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.last-message strong { color: var(--heading); }
.last-message p { margin-bottom: 0; white-space: pre-wrap; font-family: var(--font-display), serif; font-size: 1.08rem; }
.hidden-fragment { position: relative; overflow: hidden; padding: 0; }
.hidden-fragment-easter-egg { min-height: inherit; display: grid; place-items: center; padding: 1.2rem; color: var(--heading); background: rgba(var(--parchment-rgb),.9); font-family: var(--font-display), serif; font-size: 1.02rem; text-align: center; }
.hidden-fragment-cover { position: absolute; inset: 0; z-index: 2; display: grid; align-content: center; gap: .4rem; padding: 1rem; color: var(--muted); background: repeating-linear-gradient(135deg, rgba(var(--parchment-rgb),.95) 0 8px, rgba(var(--parchment-rgb),.82) 8px 9px); border-radius: 8px; }
.hidden-fragment-cover span { color: var(--heading); font-weight: 600; }
.thread-item.skipped .thread-body,
.thread-item.expired .thread-body { color: var(--neutral-fg); background: var(--neutral-bg); border-color: rgba(var(--neutral-rgb),.26); box-shadow: none; }
.thread-item.skipped .thread-marker,
.thread-item.expired .thread-marker { color: var(--neutral-fg); background: var(--neutral-bg); border-color: rgba(var(--neutral-rgb),.32); }
.pending-skipped,
.pending-expired { color: var(--neutral-fg); background: transparent; font-weight: 700; }
.thread-item.skipped::before,
.thread-item.expired::before { border-color: rgba(var(--neutral-rgb),.35); }

@media (max-width: 900px) {
  body { overflow-x: hidden; }
  .app-shell { display: block; min-height: 100vh; padding-left: 56px; }
  .mobile-rail { position: fixed; inset: 0 auto 0 0; z-index: 70; width: 56px; display: flex; flex-direction: column; align-items: center; gap: .45rem; padding: .65rem .35rem; background: rgba(var(--parchment-rgb),.96); border-right: 1px solid var(--border); box-shadow: 4px 0 18px rgba(var(--shadow-rgb),.08); }
  .rail-button { display: grid; place-items: center; width: 42px; height: 42px; padding: 0; color: var(--heading); background: transparent; border: 1px solid transparent; border-radius: 9px; font-size: 1.15rem; }
  .rail-button.active { color: var(--ivory); background: var(--navy); }
  .rail-account { margin-top: auto; font-weight: 800; }
  .hamburger-button { gap: 4px; }
  .hamburger-button span { display: block; width: 19px; height: 2px; background: currentColor; border-radius: 999px; }
  .mobile-menu-backdrop { position: fixed; inset: 0; z-index: 78; display: block; width: 100%; height: 100%; background: rgba(var(--overlay-rgb),.38); border: 0; }
  .sidebar { position: fixed; inset: 0 auto 0 56px; z-index: 80; width: min(330px, calc(100vw - 56px)); height: 100vh; padding: 1rem 1.2rem; background: var(--parchment); transform: translateX(calc(-100% - 60px)); transition: transform 190ms ease; box-shadow: 16px 0 36px rgba(var(--overlay-rgb),.18); }
  .sidebar.mobile-open { transform: translateX(0); }
  .desktop-brand { display: none; }
  .sidebar-mobile-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .sidebar nav { display: grid; overflow: visible; margin: 2rem 0; }
  .sidebar blockquote { display: block; }
  .sidebar-account { margin-top: auto; }
  .main-content { max-width: none; padding: 2rem clamp(1rem, 4vw, 2.4rem); }
  .membership-explanation { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .main-content { padding: 1.25rem .85rem 2rem; }
  .page-header { gap: 1rem; }
  .header-actions { width: 100%; justify-content: flex-start; }
  .header-actions .button { flex: 1 1 auto; }
  .thread-item { grid-template-columns: 32px 1fr; gap: .45rem; }
  .thread-item::before { left: 15px; top: 32px; }
  .thread-marker { width: 32px; height: 32px; font-size: .78rem; }
  .thread-body { padding: 1rem; }
  .turn-composer { padding: 1rem; }
  .member-row { align-items: flex-start; flex-direction: column; }
  .member-actions { width: 100%; }
  .member-actions .button { flex: 1 1 auto; }
  .account-modal { max-height: calc(100vh - 2rem); overflow-y: auto; }
}
